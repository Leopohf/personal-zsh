# Git LFS Configuration
# Oh My Zsh Git LFS plugin aliases wrapper
alias glfs='git lfs'
alias glfsi='git lfs install'
alias glfsu='git lfs uninstall'
alias glfst='git lfs track'
alias glfsut='git lfs untrack'
alias glfsl='git lfs ls-files'
alias glfsp='git lfs push'
alias glfspf='git lfs push --force'
alias glfspn='git lfs push --dry-run'
alias glfssa='git lfs status'
